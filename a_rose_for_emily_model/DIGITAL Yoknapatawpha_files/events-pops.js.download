						})
						var value = (base*v.length*event_count_multiplier)+(base*pages*page_count_multiplier)+(base*characters*character_count_multiplier);
				 		// console.log('m='+x_v+", "+y_v+", "+value);
						// if(k == 'Memphis') {
						// 	// value = 2000;
						//
						// 	console.log('memphis ='+value);
						// }
				 		// heatmap_layer.addData({x:x_v, y:y_v, value:value})
				 		// heatmap_layer_save.addData({x:save_x_v, y:save_y_v, value:value})
						$('#heat-info-table').append('<tr><td>'+k+'</td><td>'+v.length+'</td><td>'+pages+'</td><td>'+characters+'</td><td>'+value+"</td><td>"+value/heatmap_layer.getData().max+"</td><td>"+(all_locations[k].getX()+25)+"</td><td>"+(1650-(all_locations[k].getY()+30))+"</td></tr>");
				 	});
				} else {
					$('#heat-info-table').append('<tr><th>Location</th><th>Events</th><th>Pages</th><th>Characters</th><th>Value</th><th>Gradient</th></tr>');
					
				 	$.each(event_list, function(k,v) {
						pages = 0;
						characters = 0;
						$.each(v, function(i,data) {
							pages += data['pages'];
							characters += data['present'];
							characters += data['mentioned'];
						})
						var value = (base*v.length*event_count_multiplier)+(base*pages*page_count_multiplier)+(base*characters*character_count_multiplier);
						$('#heat-info-table').append('<tr><td>'+k+'</td><td>'+v.length+'</td><td>'+pages+'</td><td>'+characters+'</td><td>'+value+"</td><td>"+value/heatmap_layer.getData().max+"</td></tr>");
					});
					
				} 
				console.log(event_list);
			 }

				contentLayer.draw();
				var chron = [];
				try {
					// chron = sortHashTableByKey(chron_order, 'order');
					chron = chron_order.sort(function(a,b){return parseFloat(a.order) - parseFloat(b.order)});
				} catch(error) {
					// alert(error);
					console.log(error);
				}
				var e_num = 1;
				// events_images_in_chron_order = chron;
				$.each(chron, function (i,v) {
					// console.log(v);
					if ( v != null) {
						events_images_in_chron_order.push([v['location'], v['page'], v['event_num'], v['first_words'], v['id']]);
						events_images_in_order[v['event_num']][2] = e_num;
						e_num += 1;
					}
				})
				 // = chron_order; //sortHashTableByKey(chron_order);
				 
    }
});

}

function getEventsByNid(nids, location, title){
	if (nids.length > 1) {
		$.ajax({ 
	   type: 'GET', 
		url:'/sinatra/events_from_event_ids?ids='+nids,
	   success: function (data) { 
		   $(location).html(data);
	   }});
	} else {
		$.ajax({
		   type: 'GET',
		url:'/sinatra/events_from_ids.json?ids='+nids,
		   dataType:'json',
		   success: function (data) {
					var result_size = data["results"].length;
					var char_num = 0;
					$(location).html('<strong>Location:</strong> '+title+'<br><br>');
					// alert(data["results"].length);
					$.each(data["results"], function(index, value) {
						if (value['first_words'] != null) {
							// alert(value['CharacterName'])
							// if(value['source_text'] != null)
							var range = 'Page '+value["page_number"];
							if (value["page_number"] != value["page_end"]) {
								range = 'Pages '+value["page_number"]+'-'+value["page_end"];
							}
								$(location).append("<strong>First Words:</strong>"+value["first_words"]+" ("+range+") "+"<br>");
								$(location).append("<strong>Narrative Status:</strong>"+value["naerrative_status"]+"<br>");
								$(location).append("<strong>Event Date:</strong>"+value["event_date"]+"<br>");
								if(value['indeterminate'] == '1') {
									$(location).append("(Impossible to date more precisely)<br>");
								}
								$(location).append("<strong>Era:</strong>"+value["era"]+"<br>");
								$(location).append("<strong>Summary:</strong>"+value["summary"]+"");
								var k = value['keywords'];
								var str='';
								if (k != null) {
									k = k.replace(/ /g, "&nbsp;");
									var a = k.split('|').sort();
									$.each(a,function(i,v) {
										str += v.replace(/:/g, "&nbsp;&gt;&nbsp;")+'<br>';
									})
									$(location).append("<strong>Keywords:</strong><br>"+str);
								}
						}
					});
			}});
	}
}
