function reset() {

	var str='';

	//additions 2020-09 - begin
	if(GetURLParameter('search') != null) {
		str += '&search='+GetURLParameter('search');
	}

	// for Events
	if(GetURLParameter('era') != null) {
		str += '&era='+GetURLParameter('era');
	}
	if(GetURLParameter('first_words') != null) {
		str += '&first_words='+GetURLParameter('first_words');
	}
	if(GetURLParameter('summary') != null) {
		str += '&summary='+GetURLParameter('summary');
	}
	if(GetURLParameter('status') != null) {
		str += '&status='+GetURLParameter('status');
	}
	if(GetURLParameter('publication_begin') != null) {
		str += '&publication_begin='+GetURLParameter('publication_begin');
	}
	if(GetURLParameter('publication_end') != null) {
		str += '&publication_end='+GetURLParameter('publication_end');
	}
	if(GetURLParameter('event_begin') != null) {
		str += '&event_begin='+GetURLParameter('event_begin');
	}
	if(GetURLParameter('event_end') != null) {
		str += '&event_end='+GetURLParameter('event_end');
	}
	if(GetURLParameter('all_keywords') != null) {
		str += '&all_keywords='+GetURLParameter('all_keywords');
	}
	if(GetURLParameter('aesthetic_keyword_one') != null) {
		str += '&aesthetic_keyword_one='+GetURLParameter('aesthetic_keyword_one');
	}
	if(GetURLParameter('aesthetic_keywords_value') != null) {
		str += '&aesthetic_keywords_value='+GetURLParameter('aesthetic_keywords_value');
	}
	if(GetURLParameter('relationship_keyword_one') != null) {
		str += '&relationship_keyword_one='+GetURLParameter('relationship_keyword_one');
	}
	if(GetURLParameter('relationship_keywords_value') != null) {
		str += '&relationship_keywords_value='+GetURLParameter('relationship_keywords_value');
	}
	if(GetURLParameter('themes_and_motifs_keyword_one') != null) {
		str += '&themes_and_motifs_keyword_one='+GetURLParameter('themes_and_motifs_keyword_one');
	}
	if(GetURLParameter('themes_and_motifs_keywords_value') != null) {
		str += '&themes_and_motifs_keywords_value='+GetURLParameter('themes_and_motifs_keywords_value');
	}
