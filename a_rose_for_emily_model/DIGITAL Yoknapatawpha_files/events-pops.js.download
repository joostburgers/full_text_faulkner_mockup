						chron_order.push({'location': value["event_location"],'page' : value['page_number'], 'event_num' : events_images_in_order.length-1, 'order' : value['chronological'], 'first_words' : value['first_words'], 'id' : 'e_'+i, 'nid': value['event_nid']});
