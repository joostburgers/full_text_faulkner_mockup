		str += '&environment_keywords_value='+GetURLParameter('environment_keywords_value');
	}
	if(GetURLParameter('keywords_value') != null) {
		str += '&keywords_value='+GetURLParameter('keywords_value');
	}


	if(GetURLParameter('event_location_display_label') != null) {
		str += '&event_location_display_label='+GetURLParameter('event_location_display_label');
	}

	if(GetURLParameter('event_location') != null) {
		str += '&event_location='+GetURLParameter('event_location');
	}


	// and for Characters by Text
	if(GetURLParameter('name_mentioned') != null) {
		str += '&name_mentioned='+GetURLParameter('name_mentioned');
	}
	if(GetURLParameter('name_present') != null) {
		str += '&name_present='+GetURLParameter('name_present');
	}
