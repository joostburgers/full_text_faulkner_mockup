var event_list = {};
var active_locations = {};

function jsUcfirst(string) 
{
    return string.charAt(0).toUpperCase() + string.slice(1);
}

function hide_current_locations() {
	$.each(current_locations, function(index, value) {
		if(value == 'loading') {
			setTimeout(hide_current_locations, 500)
			return;
		}
		value.hide();
	})
}

function show_active_locations() {
	$.each(active_locations, function(index, value) {
		if(value == 'loading') {
			setTimeout(show_active_locations, 500)
			return;
		}
		value.show();
	})
}

// function sleep (time) {
//   return new Promise((resolve) => setTimeout(resolve, time));
// }
function sleepFor( sleepDuration ){
    var now = new Date().getTime();
    while(new Date().getTime() < now + sleepDuration){ /* do nothing */ } 
}
function getEvents(text) {
	var str='';
