						// console.log($.type(value["CharactersPresent"]));
						if($.type(value["characters_present"]) == 'string') {
							$.each(value["characters_present"].split(","), function(j,k) {
								var name = $.trim(k);
								page_locations[page][value['event_location']]["characters"].push(parseInt(name));
								if(people_events[name] == null) {
									people_events[name] = new Array();
								}
								people_events[name].push(value["body"]);
							});
						} else {
							page_locations[page][value['event_location']]["characters"].push(value["characters_present"]);
						}									
						if($.type(value["characters_mentioned"]) == 'string') {
