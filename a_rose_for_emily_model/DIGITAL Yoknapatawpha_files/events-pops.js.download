						// }
					}
					
					var date = value["event_date"];
					if (date.indexOf(" to ") >= 0) {
						date = parseRangeDate(date);
					} else {
						date = parseDate(date);
					}
					if (i == 28) {
						// console.log(value['Date']);
						// console.log(date);
					}
					
					var indeterminate_class = "";
					if (value["indeterminate"] == "1") {
						indeterminate_class = "indeterminate";
					}

					if ((i == 1) && ((value['event_source_text'] != 'HEAT') && (value['event_source_text'] != 'HEATN') && (value['event_source_text'] != 'HEATSS') && (value['event_source_text'] != 'HEATNW') && (value['event_source_text'] != 'HEATNE') && (value['event_source_text'] != 'HEATNE') && (value['event_source_text'] != 'HEATSE') && (value['event_source_text'] != 'HEATSW') && (value['event_source_text'] != 'HEATJ') && (value['event_source_text'] != 'HEATOY'))) {
						$("<div class=\"first_event "+indeterminate_class+"\" id=\"s_"+i+"\"></div>").appendTo('#dates');
						$("#s_"+i).css('left', 800/diff*date[0]+0);
						$("#s_"+i).css('width', "1px");
						
					}
					$("<div class=\"range range_item "+indeterminate_class+"\" id=\"r_"+i+"\"></div>").appendTo('#dates');
					$("#r_"+i).css('left', 800/diff*date[0]+0);
					$("#r_"+i).css('width', ((800/diff*(date[1]-date[0]))+1)+"px");

					if ((value['event_source_text'] == 'HEAT') || (value['event_source_text'] == 'HEATN') || (value['event_source_text'] == 'HEATSS') || (value['event_source_text'] == 'HEATNW') || (value['event_source_text'] == 'HEATNE') || (value['event_source_text'] == 'HEATNE') || (value['event_source_text'] == 'HEATSE') || (value['event_source_text'] == 'HEATSW') || (value['event_source_text'] == 'HEATJ') || (value['event_source_text'] == 'HEATOY')) {
						$("#r_"+i).css('width', "3px");
					}


					$("<div class=\"range range_item "+indeterminate_class+"\" id=\"e_"+i+"\"></div>").appendTo('#dates');
					$("#e_"+i).css('left', 800/diff*date[0]+0);
					$("#e_"+i).css('width', ((800/diff*(date[1]-date[0]))+1)+"px");

					if ((value['event_source_text'] == 'HEAT') || (value['event_source_text'] == 'HEATN') || (value['event_source_text'] == 'HEATSS') || (value['event_source_text'] == 'HEATNW') || (value['event_source_text'] == 'HEATNE') || (value['event_source_text'] == 'HEATNE') || (value['event_source_text'] == 'HEATSE') || (value['event_source_text'] == 'HEATSW') || (value['event_source_text'] == 'HEATJ') || (value['event_source_text'] == 'HEATOY')) {
						$("#e_"+i).css('width', "3px");
					}
					
					event_data[i] = {"location": value["event_location"], "events": new Array(), "characters": new Array(), 'characters_mentioned': new Array()}
					event_data[i]["events"].push(value["event_nid"]);
					if($.type(value["characters_present"]) == 'string') {
						$.each(value["characters_present"].split(","), function(j,k) {
							var name = $.trim(k);
							event_data[i]["characters"].push(parseInt(name));
							active_characters.push(parseInt(name));
						});
					} else {
						event_data[i]["characters"].push(value["Characters_present"]);
						active_characters.push(value["characters_present"]);
					}									
					if($.type(value["characters_mentioned"]) == 'string') {
						$.each(value["characters_mentioned"].split(","), function(j,k) {
							var name = $.trim(k);
							event_data[i]["characters_mentioned"].push(parseInt(name));
							active_characters.push(parseInt(name));
						});
					} else {
						event_data[i]["characters_mentioned"].push(value["characters_mentioned"]);
						active_characters.push(value["characters_mentioned"]);
					}									
					event_dates.push("#e_"+i);
					
					for(page=start; page <= stop; page+=1) {
						if (current_events_start[page] == null) {
							current_events_start[page] = events_images_in_order.length-1;
						}
						if (current_events[page] == null) {
							current_events[page] = new Array();
						}
						current_events[page].push(value['event_location']);
						if (current_dates[page] == null) {
							current_dates[page] = new Array();
						}
						current_dates[page].push("#r_"+i);
					
						if (page_locations[page] == null) {
