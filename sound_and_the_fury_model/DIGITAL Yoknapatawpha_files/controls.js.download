
var i = 1;
var howManyTimes = 433;
var timer;
function play_timeline() {
	if (section_end_page != null) {
		end_page = section_end_page;
	}
	started_chron_mode = true;
	$("#slider").slider("value", i);
	$("#e_slider").slider("value", current_events_start[i]);
	if (current_events_start[i] != null) {
		$("#c_slider").slider("value", events_images_in_order[current_events_start[i]][2]);
	}
	// alert(i);
	current_event_logos[events_images_in_order[e_prev][0]].setOpacity(0.5);
	animate_location(prev, i, current_events, current_locations);

	animate_date(i, current_dates);

	animate_section(i);
	
	started_event_mode = true;

	// $("#label").text('Page '+i);
	var delay = function() {
	            $('#label').html('Page ' + (i-1)).position({
	                my: 'center bottom',
	                at: 'center top',
	                of: $("#e_slider a"),
	                offset: "0, -11"
	            });
	        };
	
	      // wait for the ui.handle to set its position
	      setTimeout(delay, 5);
	contentLayer.draw();
	prev = i;
	if (i <= end_page) {
	i++;
	}
	cb = $("#event_type");
	if (cb.attr("checked") != "undefined" && cb.attr("checked") == "checked") {
		while ((i < end_page) && ((current_events[i] == null) || (current_events[i].length < 1))) {
			i++;
		}
	}
if( i <= (end_page) ){
			// console.log(speed);
    timer = setTimeout( play_timeline, speed*-1 );
}
};

var end_of_events = false;
function play_timeline_by_events() {
	end_of_events = false;
	next_event(false);
	if (end_of_events == false) {	
		console.log(e_speed);
timer = setTimeout( play_timeline_by_events, e_speed*-1 );			
	};
}

function play_events() {
	started_event_mode = true;
	started_chron_mode = true;
	var num = $("#e_slider").slider("value");
	if (num < total_events) {
		num += 1;
	}
	// $(".range_item").hide();	
	fade_dates();
	if (current_events[prev] != null )	{	
		$.each(current_events[prev], function(index, value) {
			if (current_event_logos[value] != null) {
				current_event_logos[value].show();
				current_active_event_logos[value].setOpacity(0.35);
				current_active_event_logos[value].hide();
			}
		});
	}			
	$("#e_slider").slider("value", num);
	$("#c_slider").slider("value", events_images_in_order[num][2]);
	$("#slider").slider("value", events_images_in_order[num][1]);
	$('#label').html('Page ' + events_images_in_order[num][1]).position({
		                of: $("#e_slider a"),
		                my: 'center bottom',
		                at: 'center top',
		                offset: "0, -11"
		            });
	
	// alert(i);
	// current_event_logos[prev].setOpacity(0.35);
	current_active_event_logos[events_images_in_order[num][0]].show();
	current_active_event_logos[events_images_in_order[num][0]].setOpacity(1);
	if (num > 0) {
		// current_event_logos[events_images_in_order[num-1][0]].setOpacity(0.5);
		current_event_logos[events_images_in_order[num-1][0]].show();
		current_active_event_logos[events_images_in_order[num-1][0]].hide();
		current_active_event_logos[events_images_in_order[num-1][0]].setOpacity(0.35);
	}
	contentLayer.draw();
	// animate_date($("#slider").slider("value"), current_dates);
	animate_event_date();
	
	animate_section($("#slider").slider("value"));
	e_prev = num;
	num += 1;
if( num < total_events ){
			// console.log(speed);
    timer = setTimeout( play_events, e_speed*-1 );
}
};
function next_event(display_info) {
	started_chron_mode = true;
	var num = $("#e_slider").slider("value");
	if ((num < (total_events-1)) || ((num == (total_events-1) && (total_events == 1) && (!started_event_mode)))) {
		if (started_event_mode) {
			num += 1;
		}

		if (display_info) {
			show_event_side_dialog(events_images_in_order[num]);
		} else {
			try {
				$('#event_words').dialog('close');
			} catch (e) {
				console.log(e);
			}
		}

		// animate_date(num, current_dates);
		// if(current_events[prev] != null) {
		// 	$.each(current_events[prev], function(index, value) {
		// 		if (current_event_logos[value] != null) {
		// 			current_event_logos[value].show();
		// 			current_active_event_logos[value].setOpacity(0.35);
		// 			current_active_event_logos[value].hide();
		// 		}
		// 	});
		// }
		$("#e_slider").slider("value", num);
		$("#slider").slider("value", events_images_in_order[num][1]);
		$("#c_slider").slider("value", events_images_in_order[num][2]);
		prev = $("#slider").slider("value");
		// animate_date($("#slider").slider("value"), current_dates);
		animate_event_date();
		$('#label').html('Page ' + events_images_in_order[num][1]).position({
			                of: $("#e_slider a"),
			                my: 'center bottom',
			                at: 'center top',
			                offset: "0, -11"
			            });
		// alert(i);
		animate_section($("#slider").slider("value"));
		if (num > 0) {
			// current_event_logos[events_images_in_order[num-1][0]].setOpacity(0.5);
			current_event_logos[events_images_in_order[num-1][0]].moveToBottom();
			current_event_logos[events_images_in_order[num-1][0]].show();
			current_active_event_logos[events_images_in_order[num-1][0]].hide();
			current_active_event_logos[events_images_in_order[num-1][0]].setOpacity(0.35);
		}
		current_active_event_logos[events_images_in_order[num][0]].moveToBottom();
		current_active_event_logos[events_images_in_order[num][0]].show();
		current_active_event_logos[events_images_in_order[num][0]].setOpacity(1);
		if(inset_image != null) {
			inset_image.moveToBottom(); 
		}
		if(out_yok != null) {
			out_yok.moveToBottom();
		}
		contentLayer.draw();
		e_prev = num;
		if (!started_event_mode) {
			started_event_mode = true;
		}
	} else {
		clearInterval(timer);
		end_of_events = true;
		
	}
};

function prev_event() {
	var num = $("#e_slider").slider("value");
	if (num > 0) {
		num -= 1;

		show_event_side_dialog(events_images_in_order[num]);
		
		// if(current_events[prev] != null) {
		// 	$.each(current_events[prev], function(index, value) {
		// 		if (current_event_logos[value] != null) {
		// 			current_event_logos[value].show();
		// 			current_active_event_logos[value].setOpacity(0.35);
		// 			current_active_event_logos[value].hide();
		// 		}
		// 	});
		// }
		$("#e_slider").slider("value", num);
		$("#slider").slider("value", events_images_in_order[num][1]);
		$("#c_slider").slider("value", events_images_in_order[num][2]);
		prev = $("#slider").slider("value");
		// animate_date($("#slider").slider("value"), current_dates);
		animate_event_date();

		$('#label').html('Page ' + events_images_in_order[num][1]).position({
			                of: $("#e_slider a"),
			                my: 'center bottom',
			                at: 'center top',
			                offset: "0, -11"
			            });
		// alert(i);
		animate_section($("#slider").slider("value"));
		if (num >= 0) {
			// current_event_logos[events_images_in_order[num-1][0]].setOpacity(0.5);
			current_event_logos[events_images_in_order[num+1][0]].moveToBottom();
			current_event_logos[events_images_in_order[num+1][0]].show();
			current_active_event_logos[events_images_in_order[num+1][0]].hide();
			current_active_event_logos[events_images_in_order[num+1][0]].setOpacity(0.35);
		}
		current_active_event_logos[events_images_in_order[num][0]].moveToBottom();
		current_active_event_logos[events_images_in_order[num][0]].show();
		current_active_event_logos[events_images_in_order[num][0]].setOpacity(1);

		if(inset_image != null) {
			inset_image.moveToBottom(); 
		}
		if(out_yok != null) {
			out_yok.moveToBottom();
		}

		contentLayer.draw();
		e_prev = num;
	}
};

function play_chron() {
	started_chron_mode = true;
	var num = $("#c_slider").slider("value");
	if (num < total_events) {
		num += 1;
	}
	try {
		$('#event_words').dialog('close');
	} catch (e) {
		console.log(e);
	}
	
	// $(".range_item").hide();	
	fade_dates();
	if (current_events[prev] != null )	{	
		$.each(current_events[prev], function(index, value) {
			if (current_event_logos[value] != null) {
				current_event_logos[value].moveToBottom();
				current_event_logos[value].show();
				current_active_event_logos[value].setOpacity(0.35);
				current_active_event_logos[value].hide();
			}
		});
	}			
	$("#c_slider").slider("value", num);
	$("#slider").slider("value", events_images_in_chron_order[num][1]);
	$("#e_slider").slider("value", events_images_in_chron_order[num][2]);
	$('#label').html('Page ' + events_images_in_chron_order[num][1]).position({
		                of: $("#e_slider a"),
		                my: 'center bottom',
		                at: 'center top',
		                offset: "0, -11"
		            });
	
	// alert(i);
	// current_event_logos[prev].setOpacity(0.35);
	current_active_event_logos[events_images_in_chron_order[num][0]].moveToBottom();
	current_active_event_logos[events_images_in_chron_order[num][0]].show();
	current_active_event_logos[events_images_in_chron_order[num][0]].setOpacity(1);
	if (num > 0) {
		// current_event_logos[events_images_in_order[num-1][0]].setOpacity(0.5);
		current_event_logos[events_images_in_chron_order[num-1][0]].moveToBottom();
		current_event_logos[events_images_in_chron_order[num-1][0]].show();
		current_active_event_logos[events_images_in_chron_order[num-1][0]].hide();
		current_active_event_logos[events_images_in_chron_order[num-1][0]].setOpacity(0.35);
	}
	
	if(inset_image != null) {
		inset_image.moveToBottom();
	}
	
	contentLayer.draw();
	// animate_date($("#slider").slider("value"), current_dates);
	animate_event_date();
	
	animate_section($("#slider").slider("value"));
	e_prev = num;
	num += 1;
if( num < total_events ){
			// console.log(speed);
    timer = setTimeout( play_chron, c_speed*-1 );
}
};

