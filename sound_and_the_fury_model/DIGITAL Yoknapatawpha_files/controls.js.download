		str += '&narrator='+GetURLParameter('narrator');
	}
	if(GetURLParameter('cause_of_death') != null) {
		str += '&cause_of_death='+GetURLParameter('cause_of_death');
	}
	if(GetURLParameter('biography') != null) {
		str += '&biography='+GetURLParameter('biography');
	}

	// Legacy, pre2020
	if(GetURLParameter('char_mentioned') != null) {
		str += '&char_mentioned='+GetURLParameter('char_mentioned');
	}
	if(GetURLParameter('char_present') != null) {
		str += '&char_present='+GetURLParameter('char_present');
	}
	if(GetURLParameter('characters_mentioned') != null) {
		str += '&characters_mentioned='+GetURLParameter('characters_mentioned');
	}
	if(GetURLParameter('characters_present') != null) {
