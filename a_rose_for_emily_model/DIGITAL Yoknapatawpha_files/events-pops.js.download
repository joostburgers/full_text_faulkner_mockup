							});
						} else {
							page_locations[page][value['event_location']]["characters_mentioned"].push(value["CharactersMentioned"]);
						}									
						if(locations_events[value['event_location']] == null) {
							locations_events[value['event_location']] = {};
							locations_events[value['event_location']][value["event_nid"]] = true;
						} else {
							locations_events[value['event_location']][value["event_nid"]] = true;
						}
					}									

					$('#r_'+i).click(function(range) {
