function show_search_locations(text){
	
	var str='';
	var data = {'text' : current_text['title']};
	if(GetURLParameter('search') == 'Location') {
		if(GetURLParameter('location') != null) {
			str += '&location='+GetURLParameter('location');
			data['location'] = GetURLParameter('location');
		}
		if(GetURLParameter('status') != null) {
